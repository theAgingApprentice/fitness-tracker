# Database Configuration
DB_HOST=fitness-tracker-db
DB_PORT=3306
DB_NAME=fitness_tracker
DB_USER=fitness_user
DB_PASSWORD=fitness_password
DB_ROOT_PASSWORD=rootpassword

# Application Settings
# Must remain 0 in production — never enable Flask debug mode on a deployed server.
FLASK_DEBUG=0
ENVIRONMENT=production
API_KEY=change_me_fitness_api_key_32chars
